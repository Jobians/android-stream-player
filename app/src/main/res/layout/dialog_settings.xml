<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTSP"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/forceTcpCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Force RTSP over TCP"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repeat mode"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/repeatModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video resize mode"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/resizeModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buffering (ms)"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/minBufferInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Min buffer ms"
            android:inputType="number" />

        <EditText
            android:id="@+id/maxBufferInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Max buffer ms"
            android:inputType="number" />

        <EditText
            android:id="@+id/bufferForPlaybackInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buffer for playback ms"
            android:inputType="number" />

        <EditText
            android:id="@+id/bufferForPlaybackAfterRebufferInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buffer for playback after rebuffer ms"
            android:inputType="number" />

        <EditText
            android:id="@+id/liveOffsetInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Live target offset ms"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>